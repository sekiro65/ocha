# ==============================================================================
# OCHA (.env)
# Only the panel port and password are needed here. Everything else is set in
# the control panel (Settings) and stored in config/settings.env.
# ==============================================================================

# Control panel port. The Explo dashboard is served on EXPLO_PROXY_PORT,
# behind the same login.
UI_PORT=8090
EXPLO_PROXY_PORT=8091

# Panel password. Every install starts with this default, and the panel makes
# you pick your own the first time you sign in.
UI_PASSWORD=Melovepassword

# Folders on this machine. Use absolute paths to reuse existing folders, e.g. the
# music folder Jellyfin already scans. Change, then run: docker compose up -d
MUSIC_PATH=./music
DOWNLOADS_PATH=./downloads
CONFIG_PATH=./config

# User and group that own your music. OCHA runs as them, never as root.
# Find yours with `id` on the host. Default 1000:1000.
PUID=1000
PGID=1000

# Behind a domain / reverse proxy: the public URLs of the panel and of Explo
# (two hostnames, each proxied to UI_PORT and EXPLO_PROXY_PORT).
# UI_PUBLIC_URL=https://ocha.example.com
# EXPLO_PUBLIC_URL=https://ocha-explo.example.com
# Other hostnames you open the panel on (IPs, localhost and .local/.lan work already)
# ALLOWED_HOSTS=nas.example.com
# Header your proxy puts the visitor's IP in, if not X-Forwarded-For
# TRUSTED_IP_HEADER=CF-Connecting-IP

# Optional Soulseek account for the slskd profile (docker compose --profile slskd up -d)
# SLSK_USERNAME=
# SLSK_PASSWORD=
# slskd web UI: http://127.0.0.1:5030 on this machine only. Change its login in slskd/slskd.yml

# ------------------------------------------------------------------------------
# Optional first-run seeds. Read once into config/settings.env, then managed in
# the panel. Safe to leave out.
# ------------------------------------------------------------------------------
# Download source: youtube (yt-dlp, default), slskd, or telegram
# DOWNLOAD_SERVICES=youtube
# EXPLO_SYSTEM=jellyfin
# SYSTEM_URL=http://192.168.1.100:8096
# LIBRARY_NAME=Music
# API_KEY=
# LISTENBRAINZ_USER=
# LISTENBRAINZ_USER_TOKEN=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
